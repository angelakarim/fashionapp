# Copy this file to .env.local and fill in the value.
#
# The n8n webhook that performs the try-on generation. It receives a
# multipart/form-data POST with `image1` (person) and `image2` (garment),
# and must respond with a binary image.
#
# Server-only on purpose — do not add a NEXT_PUBLIC_ prefix. The browser
# calls /api/tryon, which proxies to this URL, so the endpoint never ships
# to the client and the app doesn't depend on n8n sending CORS headers.
#
# Use the `/webhook/` path, which stays live while the workflow is Active
# in n8n. The editor's `/webhook-test/` path also works but must be re-armed
# ("Execute workflow") before every single request.
TRYON_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# Supabase project that backs sign-in. Find both under
# Project Settings → API in the Supabase dashboard.
#
# These ARE NEXT_PUBLIC_ on purpose — the browser talks to Supabase Auth
# directly, and the publishable key is designed to be exposed: it grants only
# what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase service_role key ("secret key" under Project Settings → API Keys).
#
# This bypasses row-level security completely, so it is server-only and must
# NEVER get a NEXT_PUBLIC_ prefix. It exists for exactly one reason: the Stripe
# webhook arrives with no session, so there is no auth.uid() for RLS to match,
# and `public.subscriptions` deliberately has no write policy — otherwise a
# user could grant themselves a subscription from the browser console.
#
# Imported only by lib/supabase/admin.ts, which is imported only by
# app/api/stripe/webhook/route.ts and app/billing/success/route.ts.
SUPABASE_SECRET_KEY=your_service_role_key

# Stripe. Test-mode values live under Developers → API keys; use the
# corresponding live-mode values in production.
#
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are server-only. The payment link
# is NEXT_PUBLIC_ because it is simply the public URL a visitor is sent to.
STRIPE_SECRET_KEY=sk_test_your_key

# Signing secret of the webhook endpoint (Developers → Webhooks → your
# endpoint). Every event is rejected unless it verifies against this, so a
# mismatch shows up as 400s in the Stripe dashboard rather than as a code bug.
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Payment Link for the $9.99/month subscription price. The app appends
# ?client_reference_id=<supabase user id>, which is what ties the payment back
# to an account — a link without it produces a payment nobody can be credited
# for. Its "after payment" redirect must point at
# <your-origin>/billing/success?session_id={CHECKOUT_SESSION_ID}.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_your_link
