# Copy this file to .env.local and fill in the value.
#
# The n8n webhook that performs the try-on generation. It receives a
# multipart/form-data POST with `image1` (person) and `image2` (garment),
# and must respond with a binary image.
#
# Server-only on purpose — do not add a NEXT_PUBLIC_ prefix. The browser
# calls /api/tryon, which proxies to this URL, so the endpoint never ships
# to the client and the app doesn't depend on n8n sending CORS headers.
#
# Use the `/webhook/` path, which stays live while the workflow is Active
# in n8n. The editor's `/webhook-test/` path also works but must be re-armed
# ("Execute workflow") before every single request.
TRYON_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# Supabase project that backs sign-in. Find both under
# Project Settings → API in the Supabase dashboard.
#
# These ARE NEXT_PUBLIC_ on purpose — the browser talks to Supabase Auth
# directly, and the publishable key is designed to be exposed: it grants only
# what row-level security allows. The service_role key bypasses RLS entirely
# and must never be added to this file or to any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
